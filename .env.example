# Firebase JS SDK configuration (public; protected by Security Rules + App Check)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Google Sign-In web client id (OAuth client of type "Web application" in the Firebase project)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Show developer tools in release builds (never for Play releases)
EXPO_PUBLIC_ENABLE_DEBUG_TOOLS=false
# Build-time (not EXPO_PUBLIC): AdMob opt-in
AEROFMS_ENABLE_ADS=false
AEROFMS_ADMOB_APP_ID=
AEROFMS_ADMOB_BANNER_ID=
AEROFMS_ADMOB_INTERSTITIAL_ID=
AEROFMS_ADMOB_REWARDED_ID=
